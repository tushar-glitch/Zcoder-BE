NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/zoycoders
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
INTERNAL_SECRET=replace-with-a-different-random-string-of-at-least-32-characters
TRUST_PROXY_HOPS=1
MAIL_FROM=ZoyCoders <no-reply@zoycoders.com>
# Without SMTP_HOST, emails are logged instead of sent (development only)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
MEDIA_BASE_URL=http://localhost:4000/uploads
UPLOAD_DIR=./uploads
