generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
}

model Admin {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  email               String               @unique
  passwordHash        String               @map("password_hash")
  role                AdminRole            @default(ADMIN)
  isActive            Boolean              @default(true) @map("is_active")
  failedLoginAttempts Int                  @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?            @map("locked_until")
  lastLoginAt         DateTime?            @map("last_login_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  sessions            AdminSession[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@map("admins")
}

model AdminSession {
  id                String    @id @default(uuid()) @db.Uuid
  adminId           String    @map("admin_id") @db.Uuid
  admin             Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique @map("token_hash")
  previousTokenHash String?   @unique @map("previous_token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([adminId])
  @@map("admin_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([adminId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Media {
  id                 String         @id @default(uuid()) @db.Uuid
  fileName           String         @map("file_name")
  altText            String         @map("alt_text")
  storageKey         String         @unique @map("storage_key")
  mimeType           String         @map("mime_type")
  sizeBytes          Int            @map("size_bytes")
  width              Int
  height             Int
  createdAt          DateTime       @default(now()) @map("created_at")
  coverBlogs         Blog[]         @relation("BlogCover")
  ogBlogs            Blog[]         @relation("BlogOg")
  authors            Author[]
  heroes             Hero[]
  serviceOgs         Service[]      @relation("ServiceOg")
  projectCovers      Project[]      @relation("ProjectCover")
  projectOgs         Project[]      @relation("ProjectOg")
  projectGalleries   ProjectImage[]
  testimonialAvatars Testimonial[]

  @@map("media")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  blogs       Blog[]

  @@map("categories")
}

model Tag {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  blogs       BlogTag[]

  @@map("tags")
}

model Author {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  bio       String?
  avatarId  String?  @map("avatar_id") @db.Uuid
  avatar    Media?   @relation(fields: [avatarId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  blogs     Blog[]

  @@map("authors")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Blog {
  id             String            @id @default(uuid()) @db.Uuid
  title          String
  slug           String            @unique
  excerpt        String?
  contentJson    Json?             @map("content_json")
  contentHtml    String?           @map("content_html")
  coverImageId   String?           @map("cover_image_id") @db.Uuid
  coverImage     Media?            @relation("BlogCover", fields: [coverImageId], references: [id], onDelete: Restrict)
  ogImageId      String?           @map("og_image_id") @db.Uuid
  ogImage        Media?            @relation("BlogOg", fields: [ogImageId], references: [id], onDelete: Restrict)
  categoryId     String?           @map("category_id") @db.Uuid
  category       Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  authorId       String?           @map("author_id") @db.Uuid
  author         Author?           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  status         BlogStatus        @default(DRAFT)
  publishedAt    DateTime?         @map("published_at")
  seoTitle       String?           @map("seo_title")
  seoDescription String?           @map("seo_description")
  readingTimeMin Int               @default(0) @map("reading_time_min")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  tags           BlogTag[]
  slugHistory    BlogSlugHistory[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@map("blogs")
}

model BlogTag {
  blogId String @map("blog_id") @db.Uuid
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tagId  String @map("tag_id") @db.Uuid
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
  @@index([tagId])
  @@map("blog_tags")
}

model BlogSlugHistory {
  id        String   @id @default(uuid()) @db.Uuid
  blogId    String   @map("blog_id") @db.Uuid
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@index([blogId])
  @@map("blog_slug_history")
}

enum HeroStatus {
  DRAFT
  PUBLISHED
}

model Hero {
  id                String     @id @default(uuid()) @db.Uuid
  title             String
  heading           String?
  subheading        String?
  primaryCtaLabel   String?    @map("primary_cta_label")
  primaryCtaUrl     String?    @map("primary_cta_url")
  secondaryCtaLabel String?    @map("secondary_cta_label")
  secondaryCtaUrl   String?    @map("secondary_cta_url")
  imageId           String?    @map("image_id") @db.Uuid
  image             Media?     @relation(fields: [imageId], references: [id], onDelete: Restrict)
  status            HeroStatus @default(DRAFT)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@index([status])
  @@map("heroes")
}

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  slug             String   @unique
  icon             String?
  shortDescription String?  @map("short_description")
  description      String?
  technologies     String[]
  seoTitle         String?  @map("seo_title")
  seoDescription   String?  @map("seo_description")
  ogImageId        String?  @map("og_image_id") @db.Uuid
  ogImage          Media?   @relation("ServiceOg", fields: [ogImageId], references: [id], onDelete: Restrict)
  sortOrder        Int      @default(0) @map("sort_order")
  isPublished      Boolean  @default(false) @map("is_published")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("services")
}

model Project {
  id             String         @id @default(uuid()) @db.Uuid
  title          String
  slug           String         @unique
  summary        String?
  description    String?
  technologies   String[]
  coverImageId   String?        @map("cover_image_id") @db.Uuid
  coverImage     Media?         @relation("ProjectCover", fields: [coverImageId], references: [id], onDelete: Restrict)
  gallery        ProjectImage[]
  demoUrl        String?        @map("demo_url")
  sourceUrl      String?        @map("source_url")
  clientName     String?        @map("client_name")
  seoTitle       String?        @map("seo_title")
  seoDescription String?        @map("seo_description")
  ogImageId      String?        @map("og_image_id") @db.Uuid
  ogImage        Media?         @relation("ProjectOg", fields: [ogImageId], references: [id], onDelete: Restrict)
  isFeatured     Boolean        @default(false) @map("is_featured")
  isPublished    Boolean        @default(false) @map("is_published")
  sortOrder      Int            @default(0) @map("sort_order")
  publishedAt    DateTime?      @map("published_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("projects")
}

model ProjectImage {
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String  @map("media_id") @db.Uuid
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  sortOrder Int     @map("sort_order")

  @@id([projectId, mediaId])
  @@map("project_images")
}

model Testimonial {
  id             String   @id @default(uuid()) @db.Uuid
  clientName     String   @map("client_name")
  clientRole     String?  @map("client_role")
  company        String?
  quote          String
  avatarId       String?  @map("avatar_id") @db.Uuid
  avatar         Media?   @relation(fields: [avatarId], references: [id], onDelete: Restrict)
  rating         Int?
  clientApproved Boolean  @default(false) @map("client_approved")
  isPublished    Boolean  @default(false) @map("is_published")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("testimonials")
}

model Faq {
  id          String   @id @default(uuid()) @db.Uuid
  question    String
  answer      String
  group       String?
  showOnHome  Boolean  @default(false) @map("show_on_home")
  isPublished Boolean  @default(false) @map("is_published")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("faqs")
}
