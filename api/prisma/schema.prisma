generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
}

model Admin {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  email               String               @unique
  passwordHash        String               @map("password_hash")
  role                AdminRole            @default(ADMIN)
  isActive            Boolean              @default(true) @map("is_active")
  failedLoginAttempts Int                  @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?            @map("locked_until")
  lastLoginAt         DateTime?            @map("last_login_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  sessions            AdminSession[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@map("admins")
}

model AdminSession {
  id                String    @id @default(uuid()) @db.Uuid
  adminId           String    @map("admin_id") @db.Uuid
  admin             Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique @map("token_hash")
  previousTokenHash String?   @unique @map("previous_token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([adminId])
  @@map("admin_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([adminId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Media {
  id         String   @id @default(uuid()) @db.Uuid
  fileName   String   @map("file_name")
  altText    String   @map("alt_text")
  storageKey String   @unique @map("storage_key")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  width      Int
  height     Int
  createdAt  DateTime @default(now()) @map("created_at")
  coverBlogs Blog[]   @relation("BlogCover")
  ogBlogs    Blog[]   @relation("BlogOg")
  authors    Author[]

  @@map("media")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  blogs       Blog[]

  @@map("categories")
}

model Tag {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  blogs       BlogTag[]

  @@map("tags")
}

model Author {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  bio       String?
  avatarId  String?  @map("avatar_id") @db.Uuid
  avatar    Media?   @relation(fields: [avatarId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  blogs     Blog[]

  @@map("authors")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Blog {
  id             String            @id @default(uuid()) @db.Uuid
  title          String
  slug           String            @unique
  excerpt        String?
  contentJson    Json?             @map("content_json")
  contentHtml    String?           @map("content_html")
  coverImageId   String?           @map("cover_image_id") @db.Uuid
  coverImage     Media?            @relation("BlogCover", fields: [coverImageId], references: [id], onDelete: Restrict)
  ogImageId      String?           @map("og_image_id") @db.Uuid
  ogImage        Media?            @relation("BlogOg", fields: [ogImageId], references: [id], onDelete: Restrict)
  categoryId     String?           @map("category_id") @db.Uuid
  category       Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  authorId       String?           @map("author_id") @db.Uuid
  author         Author?           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  status         BlogStatus        @default(DRAFT)
  publishedAt    DateTime?         @map("published_at")
  seoTitle       String?           @map("seo_title")
  seoDescription String?           @map("seo_description")
  readingTimeMin Int               @default(0) @map("reading_time_min")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  tags           BlogTag[]
  slugHistory    BlogSlugHistory[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@map("blogs")
}

model BlogTag {
  blogId String @map("blog_id") @db.Uuid
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tagId  String @map("tag_id") @db.Uuid
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
  @@index([tagId])
  @@map("blog_tags")
}

model BlogSlugHistory {
  id        String   @id @default(uuid()) @db.Uuid
  blogId    String   @map("blog_id") @db.Uuid
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@index([blogId])
  @@map("blog_slug_history")
}
